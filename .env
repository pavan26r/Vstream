# WARNING: Do NOT commit real secrets to a public repository.
# This .env contains placeholders. Replace values locally and add .env to .gitignore.

# ─── AWS ───────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
S3_RAW_BUCKET=REPLACE_WITH_S3_RAW_BUCKET
S3_PROCESSED_BUCKET=REPLACE_WITH_S3_PROCESSED_BUCKET
SQS_QUEUE_URL=REPLACE_WITH_SQS_QUEUE_URL
CLOUDFRONT_DOMAIN=REPLACE_WITH_CLOUDFRONT_DOMAIN

# ─── Node.js ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
FRONTEND_URL=http://localhost:3000
NODE_WEBHOOK_URL=http://node_app:5000/api/videos/webhook/processed

# ─── Django ────────────────────────────────────────────
DJANGO_SECRET_KEY=REPLACE_WITH_DJANGO_SECRET_KEY
DEBUG=False
